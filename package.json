{
  "name": "@modly_public/mcp-server",
  "version": "0.1.0",
  "description": "Local MCP server that exposes Modly's guild-management tools to Claude Desktop, Cursor, Cline, and any MCP-compatible agent.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "modly-mcp": "./dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modly-public/modly-mcp.git"
  },
  "homepage": "https://modly.net",
  "bugs": "https://github.com/modly-public/modly-mcp/issues",
  "keywords": ["modly", "discord", "mcp", "model-context-protocol", "ai", "agent"],
  "//": "TODO swap @modly_public/sdk back to '^0.1.0' once published to npm. Pinned to git URL today so install-from-clone and `npx github:modly-public/modly-mcp` both work without hitting the registry.",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@modly_public/sdk": "github:modly-public/modly-sdk"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
